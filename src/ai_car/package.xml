<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ai_car</name>
  <version>0.1.0</version>
  <description>ROS 2 package for the AICAR differential-drive robot with keyboard teleoperation, DYNAMIXEL wheel and arm control, IMU feedback, and planar odometry.</description>
  <maintainer email="ebyy@todo.todo">ebyy</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- Hardware communication dependencies -->
  <exec_depend>dynamixel_sdk</exec_depend>
  <exec_depend>python3-smbus</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
